{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "generated/prisma-client/**/*",
        "exclude": "generated/prisma-client/query-engine-windows.exe",
        "outDir": "dist/src"
      }
    ]
  }
}
