model CompetitorSnapshot {
  id              Int               @id @default(autoincrement())
  keywordId       Int               @map("keyword_id")
  capturedAt      DateTime          @default(now()) @map("captured_at")
  rank            Int
  trendyolProductId String          @map("trendyol_product_id")
  sellerName      String?           @map("seller_name")
  productName     String            @map("product_name")
  brand           String?
  priceCurrent    Decimal           @default(0) @map("price_current") @db.Decimal(12, 2)
  priceOriginal   Decimal           @default(0) @map("price_original") @db.Decimal(12, 2)
  ratingAverage   Decimal?          @map("rating_average") @db.Decimal(4, 2)
