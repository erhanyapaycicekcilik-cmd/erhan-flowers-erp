  transactionId Int?                @map("transaction_id")
  userId        Int                 @map("user_id")
  action        String
  reason        String?
  oldValue      Json?               @map("old_value")
  newValue      Json?               @map("new_value")
  createdAt     DateTime            @default(now()) @map("created_at")
  transaction   FinanceTransaction? @relation(fields: [transactionId], references: [id])
  user          User                @relation("FinanceAuditUser", fields: [userId], references: [id])

  @@map("finance_audit_logs")
}

model BambuCostRule {
  id                Int                   @id @default(autoincrement())
  familyId          Int                   @unique @map("family_id")
  leafStockCardId   Int?                  @map("leaf_stock_card_id")
  trunkStockCardId  Int?                  @map("trunk_stock_card_id")
  leavesPerStep     Decimal               @default(1) @map("leaves_per_step") @db.Decimal(12, 3)
  leafStepCm        Decimal               @default(10) @map("leaf_step_cm") @db.Decimal(12, 3)
  roundingMode      BambuLeafRoundingMode @default(NEAREST) @map("rounding_mode")
  trunkLengthCm     Decimal               @default(220) @map("trunk_length_cm") @db.Decimal(12, 3)
  siliconeAmount    Decimal               @default(1) @map("silicone_gr") @db.Decimal(12, 3)
  laborAmount       Decimal               @default(10) @map("labor_amount") @db.Decimal(12, 2)
  overheadAmount    Decimal               @default(5) @map("overhead_amount") @db.Decimal(12, 2)
  electricityAmount Decimal               @default(0) @map("electricity_amount") @db.Decimal(12, 2)
  packagingAmount   Decimal               @default(0) @map("packaging_amount") @db.Decimal(12, 2)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  family            ProductionFamily      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  leafStockCard     StockCard?            @relation("BambuLeafStockCard", fields: [leafStockCardId], references: [id])
  trunkStockCard    StockCard?            @relation("BambuTrunkStockCard", fields: [trunkStockCardId], references: [id])
  exceptions        BambuCostException[]

  @@map("bambu_cost_rules")
}

model BambuCostException {
  id             Int           @id @default(autoincrement())
  ruleId         Int           @map("rule_id")
  sizeCm         Int           @map("size_cm")
  leafCount      Decimal?      @map("leaf_count") @db.Decimal(12, 3)
  siliconeAmount Decimal?      @map("silicone_gr") @db.Decimal(12, 3)
  laborAmount    Decimal?      @map("labor_amount") @db.Decimal(12, 2)
  overheadAmount Decimal?      @map("overhead_amount") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  rule           BambuCostRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, sizeCm])
  @@map("bambu_cost_exceptions")
}

// Tekli yapay bambu gövdesi için boy bazlı satış fiyat tablosu. Standart
// boylar otomatik hesaplanır (doğrusal aralık doldurma), ama her satır elle
// eklenip/düzenlenip tabloyu geçersiz kılabilir (manuel giriş talebi).
model BambuStemPrice {
  id          Int      @id @default(autoincrement())
  sizeCm      Int      @unique @map("size_cm")
  pricePerStem Decimal @map("price_per_stem") @db.Decimal(10, 2)
  isManual    Boolean  @default(false) @map("is_manual")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bambu_stem_prices")
}

model StockUsageLog {
  id            Int                     @id @default(autoincrement())
  stockCardId   Int                     @map("stock_card_id")
  variantId     Int?                    @map("variant_id")
  eventType     StockUsageEventType     @map("event_type")
  eventKey      String                  @unique @map("event_key")
  quantity      Decimal                 @db.Decimal(12, 3)
  unit          String
  previousStock Decimal                 @map("previous_stock") @db.Decimal(12, 3)
  nextStock     Decimal                 @map("next_stock") @db.Decimal(12, 3)
  userId        Int                     @map("user_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  stockCard     StockCard               @relation(fields: [stockCardId], references: [id])
  variant       TrendyolProductVariant? @relation(fields: [variantId], references: [id])
  user          User                    @relation(fields: [userId], references: [id])

  @@map("stock_usage_logs")
}

model StockCountSession {
  id           Int              @id @default(autoincrement())
  title        String
  note         String?
  status       StockCountStatus @default(DRAFT)
  createdById  Int              @map("created_by_id")
  approvedById Int?             @map("approved_by_id")
  approvedAt   DateTime?        @map("approved_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdBy    User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
