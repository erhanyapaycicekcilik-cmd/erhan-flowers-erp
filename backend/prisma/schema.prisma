enum DebtTransactionType {
  DEBT_ADDED
  PAYMENT_MADE
}

model Supplier {
  id           Int               @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  transactions DebtTransaction[]

  @@map("suppliers")
}

model DebtTransaction {
  id          Int                 @id @default(autoincrement())
  supplierId  Int                 @map("supplier_id")
  type        DebtTransactionType
  amount      Decimal             @db.Decimal(12, 2)
  date        DateTime            @db.Date
  description String?
  documentNo  String?             @map("document_no")
  stockCardId Int?                @map("stock_card_id")
  quantity    Decimal?            @db.Decimal(12, 3)
  unitPrice   Decimal?            @map("unit_price") @db.Decimal(12, 4)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  stockCard   StockCard?          @relation(fields: [stockCardId], references: [id])

  @@map("debt_transactions")
}

model MarketplaceOrder {
  id                   Int                    @id @default(autoincrement())
  channelAccountId     Int?                   @map("channel_account_id")
  platform             String
  orderNumber          String                 @map("order_number")
  externalOrderId      String                 @map("external_order_id")
  status               String                 @default("CREATED")
  customerName         String?                @map("customer_name")
  customerEmail        String?                @map("customer_email")
  totalAmount          Decimal                @default(0) @map("total_amount") @db.Decimal(14, 2)
  cargoAmount          Decimal                @default(0) @map("cargo_amount") @db.Decimal(14, 2)
  discountAmount       Decimal                @default(0) @map("discount_amount") @db.Decimal(14, 2)
  currency             String                 @default("TRY")
  orderDate            DateTime?              @map("order_date")
  cargoTrackingNumber  String?                @map("cargo_tracking_number")
  cargoProvider        String?                @map("cargo_provider")
  rawPayload           Json?                  @map("raw_payload")
  stockDeducted        Boolean                @default(false) @map("stock_deducted")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  items                MarketplaceOrderItem[]

  @@unique([platform, externalOrderId])
  @@index([platform, orderDate])
  @@index([platform, status])
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  id             Int               @id @default(autoincrement())
  orderId        Int               @map("order_id")
  productName    String            @map("product_name")
  sku            String?
  barcode        String?
  quantity       Decimal           @db.Decimal(12, 3)
  unitPrice      Decimal           @map("unit_price") @db.Decimal(14, 2)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalPrice     Decimal           @map("total_price") @db.Decimal(14, 2)
  stockCardId    Int?              @map("stock_card_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  order          MarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockCard      StockCard?        @relation(fields: [stockCardId], references: [id])

  @@index([orderId])
  @@map("marketplace_order_items")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
