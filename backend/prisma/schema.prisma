model User {
  id                    Int                       @id @default(autoincrement())
  name                  String
  email                 String                    @unique
  passwordHash          String                    @map("password_hash")
  role                  UserRole                  @default(OWNER)
  status                RecordStatus              @default(ACTIVE)
  rememberToken         String?                   @map("remember_token")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  financeTransactions   FinanceTransaction[]      @relation("FinanceTransactionRecordedBy")
  financeAuditLogs      FinanceAuditLog[]         @relation("FinanceAuditUser")
  financeDebts          FinanceDebt[]             @relation("FinanceDebtCreatedBy")
  financeSalaries       FinanceSalaryRecord[]     @relation("FinanceSalaryRecordedBy")
  stockUsageLogs        StockUsageLog[]
  stockCountsCreated    StockCountSession[]       @relation("StockCountCreatedBy")
  stockCountsApproved   StockCountSession[]       @relation("StockCountApprovedBy")
  publishingLogs        PublishingLog[]           @relation("PublishingLogCreatedBy")
  knowledgeAnalysisLogs KnowledgeAnalysisLog[]    @relation("KnowledgeAnalysisLogCreatedBy")
  knowledgeFeedbacks    KnowledgeFeedback[]       @relation("KnowledgeFeedbackCreatedBy")
  retailCustomers       RetailCustomer[]          @relation("RetailCustomerCreatedBy")
  retailAddresses       RetailCustomerAddress[]   @relation("RetailAddressCreatedBy")
  retailSalesCreated    RetailSale[]              @relation("RetailSaleCreatedBy")
  retailSalesCompleted  RetailSale[]              @relation("RetailSaleCompletedBy")
  retailSalesCancelled  RetailSale[]              @relation("RetailSaleCancelledBy")
  retailPayments        RetailSalePayment[]       @relation("RetailPaymentCreatedBy")
  retailDeliveries      RetailDelivery[]          @relation("RetailDeliveryAssignedTo")
  retailDeliveriesDone  RetailDelivery[]          @relation("RetailDeliveryDeliveredBy")
  retailPrintLogs       RetailPrintLog[]          @relation("RetailPrintLogPrintedBy")
  retailStatusChanges   RetailSaleStatusHistory[] @relation("RetailStatusHistoryChangedBy")
  stockMovementsCreated StockMovement[]           @relation("StockMovementCreatedBy")

  @@map("users")
}

model Category {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  codePrefix         String             @map("code_prefix")
  startCode          Int                @map("start_code")
  currentCode        Int                @map("current_code")
  trendyolCategoryId Int?               @map("trendyol_category_id")
  status             RecordStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  products           Product[]
  productionFamilies ProductionFamily[]
  competitorKeywords CompetitorKeyword[]

  @@map("categories")
}

model Product {
  id                   Int                     @id @default(autoincrement())
  productName          String                  @map("product_name")
  modelCode            String                  @unique @map("model_code")
  categoryId           Int                     @map("category_id")
  barcode              String?                 @unique
  stockQuantity        Int                     @default(0) @map("stock_quantity")
  criticalStockLevel   Int                     @default(0) @map("critical_stock_level")
  costPrice            Float                   @default(0) @map("cost_price")
  desi                 Float                   @default(1)
  shippingCost         Float                   @default(5) @map("shipping_cost")
  shopPrice            Float                   @default(0) @map("shop_price")
  sitePrice            Float                   @default(0) @map("site_price")
  marketPrice          Float                   @default(0) @map("market_price")
  listPrice            Float                   @default(0) @map("list_price")
  imageUrls            Json                    @default("[]") @map("image_urls")
  brand                String                  @default("Erhan Flowers")
  vatRate              Int                     @default(20) @map("vat_rate")
  origin               String                  @default("Türkiye")
  colorVariant         String?                 @map("color_variant")
  material             String?
  packageDimensions    String?                 @map("package_dimensions")
  warrantyMonths       Int                     @default(0) @map("warranty_months")
  warrantyType         String?                 @map("warranty_type")
  status               RecordStatus            @default(ACTIVE)
  description          String?
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  category             Category                @relation(fields: [categoryId], references: [id])
  mediaFiles           MediaFile[]
  barcodeLogs          BarcodeLog[]
  recipe               ProductRecipe?
  productCenterVariant TrendyolProductVariant? @relation("ProductCenterProduct")
  stockMovements       StockMovement[]

  @@map("products")
}

model StockCard {
  id                              Int                           @id @default(autoincrement())
  name                            String
  sku                             String?                       @unique
  category                        String?
  color                           String?
  model                           String?
  size                            String?
  productFamily                   String?                       @map("product_family")
  productType                     String?                       @map("product_type")
  height                          String?
  width                           String?
  potType                         String?                       @map("pot_type")
  potColor                        String?                       @map("pot_color")
  potSize                         String?                       @map("pot_size")
  trunkType                       String?                       @map("trunk_type")
  leafFlowerType                  String?                       @map("leaf_flower_type")
  brand                           String?
  oldModelCode                    String?                       @map("old_model_code")
  barcode                         String?
  salePrice                       Decimal                       @default(0) @map("sale_price") @db.Decimal(12, 2)
  warehouse                       String?
  shelfLocation                   String?                       @map("shelf_location")
  shortDescription                String?                       @map("short_description")
  technicalSpecs                  String?                       @map("technical_specs")
  seoTitle                        String?                       @map("seo_title")
  metaDescription                 String?                       @map("meta_description")
  imagePath                       String?                       @map("image_path")
  description                     String?
  criticalStockLevel              Decimal                       @default(0) @map("critical_stock_level") @db.Decimal(12, 3)
  supplierName                    String?                       @map("supplier_name")
  lastMovementAt                  DateTime?                     @map("last_movement_at")
  purchaseUnit                    String                        @default("Adet") @map("purchase_unit")
  purchaseQuantity                Decimal                       @default(1) @map("purchase_quantity") @db.Decimal(12, 3)
  unit                            String
  packageContent                  Decimal                       @default(1) @map("package_content") @db.Decimal(12, 3)
  purchasePrice                   Decimal                       @default(0) @map("purchase_price") @db.Decimal(12, 2)
  manualUnitCostEnabled           Boolean                       @default(false) @map("manual_unit_cost_enabled")
  manualUnitCost                  Decimal                       @default(0) @map("manual_unit_cost") @db.Decimal(12, 4)
  automaticUnitCost               Decimal                       @default(0) @map("automatic_unit_cost") @db.Decimal(12, 4)
  stockQuantity                   Decimal                       @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  reservedQuantity                Decimal                       @default(0) @map("reserved_quantity") @db.Decimal(12, 3)
  status                          RecordStatus                  @default(ACTIVE)
  createdAt                       DateTime                      @default(now()) @map("created_at")
  updatedAt                       DateTime                      @updatedAt @map("updated_at")
  recipeItems                     RecipeItem[]
  templateComponents              ProductionTemplateComponent[]
  potOptions                      ProductionPotOption[]
  bambuLeafRules                  BambuCostRule[]               @relation("BambuLeafStockCard")
  bambuTrunkRules                 BambuCostRule[]               @relation("BambuTrunkStockCard")
  usageLogs                       StockUsageLog[]
  stockCountItems                 StockCountItem[]
  movements                       StockMovement[]
  retailSaleItems                 RetailSaleItem[]
  productCostItems                ProductCostItem[]
  productPotItems                 ProductPotItem[]
  images                          StockCardImage[]
  knowledgeDefaultLeafPlantTypes  KnowledgePlantType[]          @relation("KnowledgePlantDefaultLeafStockCard")
  knowledgeDefaultTrunkPlantTypes KnowledgePlantType[]          @relation("KnowledgePlantDefaultTrunkStockCard")
  knowledgeDefaultPotPlantTypes   KnowledgePlantType[]          @relation("KnowledgePlantDefaultPotStockCard")
  knowledgePotProfiles            KnowledgePotProfile[]
  knowledgeRecipeItems            KnowledgeRecipeItem[]
  knowledgeRules                  KnowledgeRule[]
  debtTransactions                DebtTransaction[]
  marketplaceOrderItems           MarketplaceOrderItem[]

  @@map("stock_cards")
}

model StockCardImage {
  id          Int       @id @default(autoincrement())
  stockCardId Int       @map("stock_card_id")
  fileName    String    @map("file_name")
  filePath    String    @map("file_path")
  folderName  String    @map("folder_name")
  fileType    String    @map("file_type")
  isMain      Boolean   @default(false) @map("is_main")
  createdAt   DateTime  @default(now()) @map("created_at")
  stockCard   StockCard @relation(fields: [stockCardId], references: [id], onDelete: Cascade)

  @@map("stock_card_images")
}

model StockMovement {
  id            Int        @id @default(autoincrement())
  stockCardId   Int?       @map("stock_card_id")
  productId     Int?       @map("product_id")
  variantId     Int?       @map("variant_id")
  type          String
  quantity      Decimal    @db.Decimal(12, 3)
  unit          String
  previousStock Decimal    @map("previous_stock") @db.Decimal(12, 3)
  nextStock     Decimal    @map("next_stock") @db.Decimal(12, 3)
  reason        String?
  supplierName  String?    @map("supplier_name")
  documentNo    String?    @map("document_no")
  paymentStatus String?    @map("payment_status")
  note          String?
  referenceType String?    @map("reference_type")
  referenceId   String?    @map("reference_id")
  eventKey      String?    @unique @map("event_key")
  createdById   Int?       @map("created_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  stockCard     StockCard?              @relation(fields: [stockCardId], references: [id])
  product       Product?                @relation(fields: [productId], references: [id])
  variant       TrendyolProductVariant? @relation(fields: [variantId], references: [id])
  createdBy     User?                   @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model ProductFamilyMaster {
  id                 Int                @id @default(autoincrement())
  name               String
  categoryName       String             @map("category_name")
  familyCode         String?            @unique @map("family_code")
  description        String?
  defaultKeywords    String[]           @default([]) @map("default_keywords")
  defaultSizeOptions String[]           @default([]) @map("default_size_options")
  defaultPotOptions  String[]           @default([]) @map("default_pot_options")
  sortOrder          Int                @default(0) @map("sort_order")
  status             RecordStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  families           ProductionFamily[]

  @@unique([categoryName, name])
  @@map("product_family_masters")
}

model ProductionFamily {
  id                      Int                        @id @default(autoincrement())
  masterId                Int?                       @map("master_id")
  familyName              String                     @unique @map("family_name")
  familyCode              String?                    @unique @map("family_code")
  categoryId              Int?                       @map("category_id")
  mainModelCode           String?                    @map("main_model_code")
  description             String?
  keywords                String[]                   @default([])
  autoMatchingEnabled     Boolean                    @default(false) @map("auto_matching_enabled")
  status                  RecordStatus               @default(ACTIVE)
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  master                  ProductFamilyMaster?       @relation(fields: [masterId], references: [id])
  category                Category?                  @relation(fields: [categoryId], references: [id])
  templates               ProductionRecipeTemplate[]
  variants                TrendyolProductVariant[]
  sizeOptions             ProductionSizeOption[]
  potOptions              ProductionPotOption[]
  bambuCostRule           BambuCostRule?
  knowledgePlantTypes     KnowledgePlantType[]
  knowledgeRecipeProfiles KnowledgeRecipeProfile[]
  knowledgeAnalysisLogs   KnowledgeAnalysisLog[]     @relation("KnowledgeAnalysisLogProductFamily")

  @@map("production_families")
}

model KnowledgePlantType {
  id                      Int                      @id @default(autoincrement())
  name                    String
  code                    String?                  @unique
  normalizedName          String                   @map("normalized_name")
  description             String?
  productFamilyId         Int?                     @map("product_family_id")
  defaultLeafStockCardId  Int?                     @map("default_leaf_stock_card_id")
  defaultTrunkStockCardId Int?                     @map("default_trunk_stock_card_id")
  defaultPotStockCardId   Int?                     @map("default_pot_stock_card_id")
  defaultRecipeId         Int?                     @unique @map("default_recipe_id")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  productFamily           ProductionFamily?        @relation(fields: [productFamilyId], references: [id], onDelete: SetNull)
  defaultLeafStockCard    StockCard?               @relation("KnowledgePlantDefaultLeafStockCard", fields: [defaultLeafStockCardId], references: [id], onDelete: SetNull)
  defaultTrunkStockCard   StockCard?               @relation("KnowledgePlantDefaultTrunkStockCard", fields: [defaultTrunkStockCardId], references: [id], onDelete: SetNull)
  defaultPotStockCard     StockCard?               @relation("KnowledgePlantDefaultPotStockCard", fields: [defaultPotStockCardId], references: [id], onDelete: SetNull)
  defaultRecipe           KnowledgeRecipeProfile?  @relation("KnowledgePlantDefaultRecipe", fields: [defaultRecipeId], references: [id], onDelete: SetNull)
  aliases                 KnowledgeAlias[]
  recipeProfiles          KnowledgeRecipeProfile[] @relation("KnowledgeRecipeProfilePlantType")
  analysisLogs            KnowledgeAnalysisLog[]   @relation("KnowledgeAnalysisLogPlantType")
  rules                   KnowledgeRule[]

  @@index([normalizedName])
  @@index([isActive])
  @@map("knowledge_plant_types")
}

model KnowledgeAlias {
  id              Int                      @id @default(autoincrement())
  alias           String
  normalizedAlias String                   @map("normalized_alias")
  entityType      KnowledgeAliasEntityType @map("entity_type")
  plantTypeId     Int?                     @map("plant_type_id")
  potProfileId    Int?                     @map("pot_profile_id")
  materialRuleId  Int?                     @map("material_rule_id")
  priority        Int                      @default(100)
  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  plantType       KnowledgePlantType?      @relation(fields: [plantTypeId], references: [id], onDelete: SetNull)
  potProfile      KnowledgePotProfile?     @relation(fields: [potProfileId], references: [id], onDelete: SetNull)
  materialRule    KnowledgeRule?           @relation(fields: [materialRuleId], references: [id], onDelete: SetNull)

  @@index([normalizedAlias])
  @@index([entityType, isActive])
  @@map("knowledge_aliases")
}

model KnowledgePotProfile {
  id             Int                    @id @default(autoincrement())
  name           String
  normalizedName String                 @map("normalized_name")
  materialType   String?                @map("material_type")
  color          String?
  width          Decimal?               @db.Decimal(12, 2)
  depth          Decimal?               @db.Decimal(12, 2)
  height         Decimal?               @db.Decimal(12, 2)
  diameter       Decimal?               @db.Decimal(12, 2)
  stockCardId    Int?                   @map("stock_card_id")
  priority       Int                    @default(100)
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  stockCard      StockCard?             @relation(fields: [stockCardId], references: [id], onDelete: SetNull)
  aliases        KnowledgeAlias[]
  analysisLogs   KnowledgeAnalysisLog[] @relation("KnowledgeAnalysisLogPotProfile")

  @@index([normalizedName])
  @@index([isActive])
  @@map("knowledge_pot_profiles")
}

model KnowledgeRecipeProfile {
  id                  Int                   @id @default(autoincrement())
  name                String
  plantTypeId         Int?                  @map("plant_type_id")
  productFamilyId     Int?                  @map("product_family_id")
  minHeightCm         Int?                  @map("min_height_cm")
  maxHeightCm         Int?                  @map("max_height_cm")
  priority            Int                   @default(100)
  isDefault           Boolean               @default(false) @map("is_default")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  plantType           KnowledgePlantType?   @relation("KnowledgeRecipeProfilePlantType", fields: [plantTypeId], references: [id], onDelete: SetNull)
  defaultForPlantType KnowledgePlantType?   @relation("KnowledgePlantDefaultRecipe")
  productFamily       ProductionFamily?     @relation(fields: [productFamilyId], references: [id], onDelete: SetNull)
  items               KnowledgeRecipeItem[]

  @@index([plantTypeId, isActive])
  @@index([productFamilyId, isActive])
  @@map("knowledge_recipe_profiles")
}

model KnowledgeRecipeItem {
  id              Int                          @id @default(autoincrement())
  recipeProfileId Int                          @map("recipe_profile_id")
  stockCardId     Int?                         @map("stock_card_id")
  componentType   KnowledgeRecipeComponentType @map("component_type")
  quantity        Decimal                      @default(0) @db.Decimal(12, 3)
  unit            String
  isOptional      Boolean                      @default(false) @map("is_optional")
  sortOrder       Int                          @default(0) @map("sort_order")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  recipeProfile   KnowledgeRecipeProfile       @relation(fields: [recipeProfileId], references: [id], onDelete: Cascade)
  stockCard       StockCard?                   @relation(fields: [stockCardId], references: [id], onDelete: SetNull)

  @@index([recipeProfileId, sortOrder])
  @@map("knowledge_recipe_items")
}

model KnowledgeRule {
  id            Int                 @id @default(autoincrement())
  name          String
  ruleType      KnowledgeRuleType   @map("rule_type")
  ruleKind      String              @default("GENERAL") @map("rule_kind")
  plantTypeId   Int?                @map("plant_type_id")
  heightCm      Int?                @map("height_cm")
  stockCardId   Int?                @map("stock_card_id")
  quantity      Decimal?            @db.Decimal(12, 3)
  unit          String?
  amountTl      Decimal?            @map("amount_tl") @db.Decimal(14, 2)
  conditionJson Json                @map("condition_json")
  actionJson    Json                @map("action_json")
  priority      Int                 @default(100)
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  plantType     KnowledgePlantType? @relation(fields: [plantTypeId], references: [id], onDelete: Cascade)
  stockCard     StockCard?          @relation(fields: [stockCardId], references: [id], onDelete: SetNull)
  aliases       KnowledgeAlias[]
  feedbacks     KnowledgeFeedback[]

  @@index([ruleType, isActive])
  @@index([ruleKind, plantTypeId, heightCm, isActive])
  @@map("knowledge_rules")
}

model KnowledgeAnalysisLog {
  id                      Int                  @id @default(autoincrement())
  inputText               String               @map("input_text")
  normalizedInput         String               @map("normalized_input")
  detectedPlantTypeId     Int?                 @map("detected_plant_type_id")
  detectedProductFamilyId Int?                 @map("detected_product_family_id")
  detectedPotProfileId    Int?                 @map("detected_pot_profile_id")
  detectedHeightCm        Int?                 @map("detected_height_cm")
  confidenceScore         Decimal              @default(0) @map("confidence_score") @db.Decimal(5, 4)
  resultJson              Json?                @map("result_json")
  acceptedByUser          Boolean              @default(false) @map("accepted_by_user")
