model StockCountItem {
  id               Int               @id @default(autoincrement())
  sessionId        Int               @map("session_id")
  stockCardId      Int               @map("stock_card_id")
  snapshotQuantity Decimal           @map("snapshot_quantity") @db.Decimal(12, 3)
  countedQuantity  Decimal?          @map("counted_quantity") @db.Decimal(12, 3)
  difference       Decimal           @default(0) @db.Decimal(12, 3)
  note             String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  session          StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stockCard        StockCard         @relation(fields: [stockCardId], references: [id])

  @@unique([sessionId, stockCardId])
  @@map("stock_count_items")
}

model CompetitorKeyword {
