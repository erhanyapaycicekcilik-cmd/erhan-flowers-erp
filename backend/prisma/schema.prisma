}

model ProductMediaAudit {
  id                  Int                       @id @default(autoincrement())
  companyId           Int                       @map("company_id")
  productId           Int?                      @map("product_id")
  channel             ProductMediaAuditChannel
  status              ProductMediaAuditStatus   @default(QUEUED)
  overallVisualScore  Decimal                   @default(0) @map("overall_visual_score") @db.Decimal(4, 1)
  mainImageScore      Decimal                   @default(0) @map("main_image_score") @db.Decimal(4, 1)
  realismScore        Decimal                   @default(0) @map("realism_score") @db.Decimal(4, 1)
  lifestyleScore      Decimal                   @default(0) @map("lifestyle_score") @db.Decimal(4, 1)
  detailScore         Decimal                   @default(0) @map("detail_score") @db.Decimal(4, 1)
  measurementScore    Decimal                   @default(0) @map("measurement_score") @db.Decimal(4, 1)
  consistencyScore    Decimal                   @default(0) @map("consistency_score") @db.Decimal(4, 1)
  commercialScore     Decimal                   @default(0) @map("commercial_score") @db.Decimal(4, 1)
  changePriorityScore Int                       @default(0) @map("change_priority_score")
  recommendation      ProductMediaRecommendation
  publishState        ProductMediaPublishState  @default(DRAFT) @map("publish_state")
  aiSummary           String?                   @map("ai_summary")
  aiIssues            Json                      @default("[]") @map("ai_issues")
  aiRecommendation    String?                   @map("ai_recommendation")
  recommendedSet      Json                      @default("[]") @map("recommended_set")
  salesSignals        Json                      @default("{}") @map("sales_signals")
  beforeAfterPlan     Json                      @default("{}") @map("before_after_plan")
  mediaTaskId         Int?                      @map("media_task_id")
  analyzedAt          DateTime?                 @map("analyzed_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  issues              ProductMediaIssue[]
  requirements        ProductMediaRequirement[]
  images              ProductMediaAuditImage[]

  @@index([companyId, channel])
  @@index([companyId, productId, channel])
  @@index([companyId, status])
  @@map("product_media_audits")
}

model ProductMediaIssue {
  id          Int                       @id @default(autoincrement())
  auditId     Int                       @map("audit_id")
  issueType   String                    @map("issue_type")
  severity    ProductMediaIssueSeverity
  title       String
  description String
  imageUrl    String?                   @map("image_url")
  createdAt   DateTime                  @default(now()) @map("created_at")
  audit       ProductMediaAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@map("product_media_issues")
}

model ProductMediaRequirement {
  id        Int                           @id @default(autoincrement())
  auditId   Int                           @map("audit_id")
  mediaType ProductMediaRequirementType   @map("media_type")
  status    ProductMediaRequirementStatus
  audit     ProductMediaAudit             @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, mediaType])
  @@index([auditId, status])
  @@map("product_media_requirements")
}

model ProductMediaAuditImage {
  id             Int                         @id @default(autoincrement())
  auditId        Int                         @map("audit_id")
  productImageId Int?                        @map("product_image_id")
  imageUrl       String                      @map("image_url")
  sortOrder      Int                         @default(0) @map("sort_order")
  imageType      ProductMediaRequirementType @map("image_type")
  score          Decimal                     @default(0) @db.Decimal(4, 1)
  analysisData   Json                        @default("{}") @map("analysis_data")
  createdAt      DateTime                    @default(now()) @map("created_at")
  audit          ProductMediaAudit           @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, sortOrder])
  @@map("product_media_audit_images")
}

