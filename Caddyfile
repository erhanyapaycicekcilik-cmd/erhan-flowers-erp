# ERP Yönetim Paneli — Güvenli HTTPS
erp.florayapaycicek.com {
    reverse_proxy frontend:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    log {
        output file /var/log/caddy/erp-access.log
        format json
    }
}

# Backend API — Güvenli HTTPS
api.florayapaycicek.com {
    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "https://erp.florayapaycicek.com"
        header Access-Control-Allow-Credentials "true"
        header Access-Control-Allow-Methods "GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Accept, Authorization, x-admin-token"
        header Access-Control-Max-Age "3600"
        respond "" 204
    }

    reverse_proxy backend:8001

    request_body {
        max_size 50MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}

# B2C Müşteri Sitesi — FloraYapayCiçek.com
florayapaycicek.com, www.florayapaycicek.com {
    reverse_proxy florayapay:3200

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    }

    log {
        output file /var/log/caddy/site-access.log
        format json
    }
}
