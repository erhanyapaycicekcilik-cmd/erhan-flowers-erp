# Flora E-Ticaret Sitesi — Ana domain: erhanflowers.com
erhanflowers.com, www.erhanflowers.com {
    # Gzip + Zstandard sıkıştırma (HTML/CSS/JS boyutunu ~70% küçültür)
    encode zstd gzip

    # Meta/WhatsApp katalog feed — backend'den servis edilir
    handle /feed/meta-catalog {
        rewrite * /public/catalog/meta-feed
        reverse_proxy backend:8001
    }

    # Next.js static dosyaları — içerik hash'li, 1 yıl cache (immutable)
    handle /_next/static/* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Ürün görselleri ve statik public dosyalar — 7 gün cache
    handle /fiber-saksi/* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }
    handle /bostann/* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }
    handle /metal-saksi/* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }
    handle /kaktus-sazlik/* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }
    handle /images/* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    # Next.js image optimizer çıktıları — 7 gün cache
    handle /_next/image* {
        reverse_proxy florayapay:3200
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    # Diğer tüm istekler florayapay'e (HTML sayfaları — cache'lenmiyor)
    handle {
        reverse_proxy florayapay:3200
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=()"
    }

    log {
        output file /var/log/caddy/flora-access.log
        format json
    }
}

florayapaycicek.com, www.florayapaycicek.com {
    redir https://www.erhanflowers.com{uri} 301
}

# ERP Yönetim Paneli — Güvenli HTTPS
erp.erhanflowers.com, erp.florayapaycicek.com {
    encode zstd gzip

    handle /_next/static/* {
        reverse_proxy frontend:3000
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle /_next/image* {
        reverse_proxy frontend:3000
        header Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    handle {
        reverse_proxy frontend:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=()"
    }

    log {
        output file /var/log/caddy/erp-access.log
        format json
    }
}

# Backend API — Güvenli HTTPS
api.erhanflowers.com, api.florayapaycicek.com {
    reverse_proxy backend:8001 {
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    request_body {
        max_size 500MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}
