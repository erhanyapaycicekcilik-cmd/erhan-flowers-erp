# Flora E-Ticaret Sitesi — Ana domain: erhanflowers.com
erhanflowers.com, www.erhanflowers.com {
    reverse_proxy florayapay:3200

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=()"
    }

    log {
        output file /var/log/caddy/flora-access.log
        format json
    }
}

# Eski domain → yeni domain yönlendirme (301 kalıcı)
florayapaycicek.com, www.florayapaycicek.com {
    redir https://www.erhanflowers.com{uri} 301
}

# ERP Yönetim Paneli — Güvenli HTTPS
erp.erhanflowers.com, erp.florayapaycicek.com {
    reverse_proxy frontend:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=()"
    }

    log {
        output file /var/log/caddy/erp-access.log
        format json
    }
}

# Backend API — Güvenli HTTPS
api.erhanflowers.com, api.florayapaycicek.com {
    @options method OPTIONS
    @from-erp header Origin https://erp.erhanflowers.com
    @from-erp-old header Origin https://erp.florayapaycicek.com

    handle @options {
        header @from-erp Access-Control-Allow-Origin "https://erp.erhanflowers.com"
        header @from-erp-old Access-Control-Allow-Origin "https://erp.florayapaycicek.com"
        header Access-Control-Allow-Credentials "true"
        header Access-Control-Allow-Methods "GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Accept, Authorization, x-admin-token"
        header Access-Control-Max-Age "3600"
        respond "" 204
    }

    reverse_proxy backend:8001

    header @from-erp Access-Control-Allow-Origin "https://erp.erhanflowers.com"
    header @from-erp-old Access-Control-Allow-Origin "https://erp.florayapaycicek.com"
    header Access-Control-Allow-Credentials "true"

    request_body {
        max_size 500MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}
