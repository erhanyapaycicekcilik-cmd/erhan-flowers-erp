# FloraYapayCiçek — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri doldur

# Site URL (production'da https://florayapay.com)
SITE_URL=https://florayapay.com

# Google Tag Manager ID (GTM-XXXXXXX formatında)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console doğrulama kodu
GOOGLE_SITE_VERIFICATION=

# ERP Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8101

# Ödeme sistemi (sağlayıcıya göre doldur)
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_KEY=
PAYMENT_MERCHANT_SALT=
PAYMENT_API_URL=

# Kargo API
CARGO_API_KEY=
