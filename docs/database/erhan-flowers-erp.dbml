  last_synced_at timestamp [note: "Prisma: lastSyncedAt"]
  cargo_provider varchar [note: "Prisma: cargoProvider"]
  cargo_tracking_number varchar [note: "Prisma: cargoTrackingNumber"]
  order_date timestamp [note: "Prisma: orderDate"]
  delivery_due_at timestamp [note: "Prisma: deliveryDueAt"]
  completed_at timestamp [note: "Prisma: completedAt"]
  cancelled_at timestamp [note: "Prisma: cancelledAt"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]
  created_by_id int [not null, note: "Prisma: createdById"]
  completed_by_id int [note: "Prisma: completedById"]
  cancelled_by_id int [note: "Prisma: cancelledById"]
  invoice_status RetailInvoiceStatus [not null, default: 'WAITING', note: "Prisma: invoiceStatus"]
  invoice_note varchar [note: "Prisma: invoiceNote"]

