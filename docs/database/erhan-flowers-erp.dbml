  name varchar [unique, not null]
  status RecordStatus [not null, default: 'ACTIVE']
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]
}

Table finance_transactions {
  id int [pk, increment]
  transaction_type FinanceTransactionType [not null, note: "Prisma: transactionType"]
  direction FinanceDirection [not null]
  category_id int [note: "Prisma: categoryId"]
  amount decimal(14,2) [not null]
  transaction_date timestamp [not null, note: "Prisma: transactionDate"]
  account_id int [not null, note: "Prisma: accountId"]
  description varchar [not null]
  linked_record_type varchar [note: "Prisma: linkedRecordType"]
  linked_record_id varchar [note: "Prisma: linkedRecordId"]
  external_key varchar [unique, note: "Prisma: externalKey"]
  recorded_by_user_id int [not null, note: "Prisma: recordedByUserId"]
  status FinanceRecordStatus [not null, default: 'ACTIVE']
  cancel_reason varchar [note: "Prisma: cancelReason"]
  correction_of_id int [note: "Prisma: correctionOfId"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]

  indexes {
    (transaction_date)
    (linked_record_type, linked_record_id)
  }
}

Table finance_debts {
  id int [pk, increment]
  debt_type FinanceTransactionType [not null, note: "Prisma: debtType"]
  title varchar [not null]
  party_name varchar [note: "Prisma: partyName"]
  amount decimal(14,2) [not null]
  remaining_amount decimal(14,2) [not null, note: "Prisma: remainingAmount"]
  due_date timestamp [not null, note: "Prisma: dueDate"]
  account_id int [note: "Prisma: accountId"]
  linked_record_type varchar [note: "Prisma: linkedRecordType"]
  linked_record_id varchar [note: "Prisma: linkedRecordId"]
  status FinancePaymentStatus [not null, default: 'PENDING']
  created_by_user_id int [not null, note: "Prisma: createdByUserId"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]

  indexes {
    (due_date)
  }
}

Table finance_marketplace_daily_records {
  id int [pk, increment]
  channel_id int [not null, note: "Prisma: channelId"]
  record_date timestamp [not null, note: "Prisma: recordDate"]
  order_count int [not null, default: 0, note: "Prisma: orderCount"]
  gross_sales decimal(14,2) [not null, default: 0, note: "Prisma: grossSales"]
  cancellation_amount decimal(14,2) [not null, default: 0, note: "Prisma: cancellationAmount"]
  return_amount decimal(14,2) [not null, default: 0, note: "Prisma: returnAmount"]
  commission_amount decimal(14,2) [not null, default: 0, note: "Prisma: commissionAmount"]
  cargo_deduction decimal(14,2) [not null, default: 0, note: "Prisma: cargoDeduction"]
  advertising_deduction decimal(14,2) [not null, default: 0, note: "Prisma: advertisingDeduction"]
  other_deduction decimal(14,2) [not null, default: 0, note: "Prisma: otherDeduction"]
  net_settlement decimal(14,2) [not null, default: 0, note: "Prisma: netSettlement"]
  expected_payment_date timestamp [note: "Prisma: expectedPaymentDate"]
  actual_payment decimal(14,2) [not null, default: 0, note: "Prisma: actualPayment"]
  payment_status FinancePaymentStatus [not null, default: 'PENDING', note: "Prisma: paymentStatus"]
  account_id int [note: "Prisma: accountId"]
  transaction_id int [note: "Prisma: transactionId"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]

  indexes {
    (channel_id, record_date) [unique]
  }
}

Table finance_recurring_payments {
  id int [pk, increment]
  title varchar [not null]
  category_id int [not null, note: "Prisma: categoryId"]
  account_id int [note: "Prisma: accountId"]
  amount decimal(14,2) [not null]
  frequency FinanceRecurringFrequency [not null]
  next_due_date timestamp [not null, note: "Prisma: nextDueDate"]
  description varchar
  status RecordStatus [not null, default: 'ACTIVE']
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]
}

Table finance_salary_records {
  id int [pk, increment]
  staff_id varchar [note: "Prisma: staffId"]
  staff_name varchar [not null, note: "Prisma: staffName"]
  period varchar [not null]
  net_salary decimal(14,2) [not null, note: "Prisma: netSalary"]
  advance decimal(14,2) [not null, default: 0]
  bonus decimal(14,2) [not null, default: 0]
  deduction decimal(14,2) [not null, default: 0]
  paid_amount decimal(14,2) [not null, default: 0, note: "Prisma: paidAmount"]
  remaining_amount decimal(14,2) [not null, note: "Prisma: remainingAmount"]
  payment_date timestamp [note: "Prisma: paymentDate"]
  account_id int [note: "Prisma: accountId"]
  status FinancePaymentStatus [not null, default: 'PENDING']
  transaction_id int [note: "Prisma: transactionId"]
  recorded_by_user_id int [not null, note: "Prisma: recordedByUserId"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]

  indexes {
    (staff_name, period) [unique]
  }
}

Table finance_audit_logs {
  id int [pk, increment]
  transaction_id int [note: "Prisma: transactionId"]
  user_id int [not null, note: "Prisma: userId"]
  action varchar [not null]
  reason varchar
  old_value jsonb [note: "Prisma: oldValue"]
  new_value jsonb [note: "Prisma: newValue"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
}

Table bambu_cost_rules {
  id int [pk, increment]
  family_id int [unique, not null, note: "Prisma: familyId"]
  leaf_stock_card_id int [note: "Prisma: leafStockCardId"]
  trunk_stock_card_id int [note: "Prisma: trunkStockCardId"]
  leaves_per_step decimal(12,3) [not null, default: 1, note: "Prisma: leavesPerStep"]
  leaf_step_cm decimal(12,3) [not null, default: 10, note: "Prisma: leafStepCm"]
  rounding_mode BambuLeafRoundingMode [not null, default: 'NEAREST', note: "Prisma: roundingMode"]
  trunk_length_cm decimal(12,3) [not null, default: 220, note: "Prisma: trunkLengthCm"]
  silicone_gr decimal(12,3) [not null, default: 1, note: "Prisma: siliconeAmount"]
  labor_amount decimal(12,2) [not null, default: 10, note: "Prisma: laborAmount"]
  overhead_amount decimal(12,2) [not null, default: 5, note: "Prisma: overheadAmount"]
  electricity_amount decimal(12,2) [not null, default: 0, note: "Prisma: electricityAmount"]
  packaging_amount decimal(12,2) [not null, default: 0, note: "Prisma: packagingAmount"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]
}

Table bambu_cost_exceptions {
  id int [pk, increment]
  rule_id int [not null, note: "Prisma: ruleId"]
  size_cm int [not null, note: "Prisma: sizeCm"]
  leaf_count decimal(12,3) [note: "Prisma: leafCount"]
  silicone_gr decimal(12,3) [note: "Prisma: siliconeAmount"]
  labor_amount decimal(12,2) [note: "Prisma: laborAmount"]
  overhead_amount decimal(12,2) [note: "Prisma: overheadAmount"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]

  indexes {
    (rule_id, size_cm) [unique]
  }
}

Table stock_usage_logs {
  id int [pk, increment]
  stock_card_id int [not null, note: "Prisma: stockCardId"]
  variant_id int [note: "Prisma: variantId"]
  event_type StockUsageEventType [not null, note: "Prisma: eventType"]
  event_key varchar [unique, not null, note: "Prisma: eventKey"]
  quantity decimal(12,3) [not null]
  unit varchar [not null]
  previous_stock decimal(12,3) [not null, note: "Prisma: previousStock"]
  next_stock decimal(12,3) [not null, note: "Prisma: nextStock"]
  user_id int [not null, note: "Prisma: userId"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
}

Table stock_count_sessions {
  id int [pk, increment]
  title varchar [not null]
  note varchar
  status StockCountStatus [not null, default: 'DRAFT']
  created_by_id int [not null, note: "Prisma: createdById"]
  approved_by_id int [note: "Prisma: approvedById"]
  approved_at timestamp [note: "Prisma: approvedAt"]
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]
}

Table stock_count_items {
  id int [pk, increment]
  session_id int [not null, note: "Prisma: sessionId"]
  stock_card_id int [not null, note: "Prisma: stockCardId"]
  snapshot_quantity decimal(12,3) [not null, note: "Prisma: snapshotQuantity"]
  counted_quantity decimal(12,3) [note: "Prisma: countedQuantity"]
  difference decimal(12,3) [not null, default: 0]
  note varchar
  created_at timestamp [not null, default: `now()`, note: "Prisma: createdAt"]
  updated_at timestamp [not null, note: "Prisma: updatedAt; @updatedAt"]

  indexes {
    (session_id, stock_card_id) [unique]
  }
}

