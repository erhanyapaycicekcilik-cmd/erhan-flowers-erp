  internal_note varchar [note: "Prisma: internalNote"]
  event_key varchar [unique, not null, note: "Prisma: eventKey"]
  platform_order_number varchar [note: "Prisma: platformOrderNumber"]
  external_order_id varchar [note: "Prisma: externalOrderId"]
  idempotency_key varchar [unique, note: "Prisma: idempotencyKey"]
