  subtotal decimal(14,2) [not null, default: 0]
  discount_total decimal(14,2) [not null, default: 0, note: "Prisma: discountTotal"]
  delivery_fee decimal(14,2) [not null, default: 0, note: "Prisma: deliveryFee"]
